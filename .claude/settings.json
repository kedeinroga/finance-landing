{
  "permissions": {
    "deny": [
      "Bash(git push *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(tofu apply *)",
      "Bash(tofu destroy *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(*.tfvars)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p8)",
      "Read(*.p12)",
      "Read(*.jks)",
      "Read(environments/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
