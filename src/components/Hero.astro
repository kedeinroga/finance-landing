---
import { Icon } from 'astro-icon/components';

const LOGIN_URL = 'https://finance.kedein.com/login';
const monthLabel = new Intl.DateTimeFormat('es-PE', { month: 'long' }).format(new Date());
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">finanzas para Perú</p>
      <h1>
        Tu dinero,<br />
        todo en <em>un lugar</em>.
      </h1>
      <p class="hero-subtitle">
        Reenvía la alerta de Yape, Plin o tu banco por correo, conecta tu Gmail o anótalo a mano.
        Todo entra al mismo dashboard.
      </p>
      <div class="hero-actions">
        <a href={LOGIN_URL} class="btn btn-on-dark">Iniciar sesión</a>
      </div>
    </div>

    <div class="hero-replica" aria-hidden="true">
      <div class="replica-card">
        <div class="replica-top">
          <p class="replica-kicker">Gasto de hoy</p>
          <p class="replica-amount">S/ 514<span class="cents">.40</span></p>
          <p class="replica-total">Gastos de {monthLabel}: S/ 4,555.83</p>
        </div>
        <div class="replica-body">
          <div class="replica-toprow">
            <span class="replica-label">Balance de {monthLabel}</span>
            <span class="replica-label">47 movimientos</span>
          </div>
          <p class="replica-net tone-income">+S/ 1,564<span class="cents">.17</span></p>
          <div class="replica-cols">
            <div>
              <span class="replica-col-label">Ingresos</span>
              <span class="replica-col-value tone-income">S/ 6,120.00</span>
            </div>
            <div>
              <span class="replica-col-label">Egresos</span>
              <span class="replica-col-value tone-ink">S/ 4,555.83</span>
            </div>
          </div>

          <p class="replica-label replica-rows-label">Últimos movimientos</p>
          <div class="replica-row">
            <span class="replica-avatar replica-avatar--income">
              <Icon name="lucide:briefcase" />
            </span>
            <span class="replica-row-main">
              <span class="replica-row-title">Ana Torres</span>
              <span class="replica-row-sub">Trabajo / Freelance · Yape</span>
            </span>
            <span class="replica-row-amount tone-income">+S/ 35.00</span>
          </div>
          <div class="replica-row">
            <span class="replica-avatar replica-avatar--income">
              <Icon name="lucide:dollar-sign" />
            </span>
            <span class="replica-row-main">
              <span class="replica-row-title">Diego Ramírez</span>
              <span class="replica-row-sub">Transferencia recibida · Plin</span>
            </span>
            <span class="replica-row-amount tone-income">+S/ 120.00</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xxl) var(--space-xxxl);
    background: linear-gradient(160deg, var(--primary-deep) 0%, var(--primary) 100%);
    /* Expone la fase "exit" del hero a MobileCtaBar.astro (fuera de <main>) vía timeline-scope en global.css */
    view-timeline-name: --hero-exit;
    view-timeline-axis: block;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--space-xxxl);
  }

  .eyebrow {
    color: var(--white);
    margin-bottom: var(--space-lg);
  }

  h1 {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--white);
    margin-bottom: var(--space-lg);
  }

  h1 em {
    font-style: italic;
  }

  .hero-subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: var(--white);
    max-width: 46ch;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .hero-replica {
    display: flex;
    justify-content: center;
  }

  /* Réplica de IndividualDashboard.tsx (Home Individuo) — tarjeta única, jerarquía de un elemento */
  .replica-card {
    width: 100%;
    max-width: 340px;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .replica-top {
    background: var(--primary);
    padding: var(--space-lg);
    text-align: center;
  }

  .replica-kicker {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
    margin-bottom: var(--space-xs);
  }

  .replica-amount {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 700;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }

  .replica-amount .cents {
    font-size: calc(1em * 0.55);
  }

  .replica-total {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--white);
    margin-top: var(--space-xs);
  }

  .replica-body {
    background: var(--surface-tint);
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-sm);
  }

  .replica-toprow {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .replica-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .replica-net {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .replica-net .cents {
    font-size: calc(1em * 0.55);
  }

  .tone-income {
    color: var(--income);
  }

  .tone-ink {
    color: var(--ink);
  }

  .replica-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  .replica-col-label {
    font-size: 12px;
    color: var(--text-muted);
    display: block;
  }

  .replica-col-value {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
  }

  .replica-rows-label {
    margin-top: var(--space-sm);
  }

  .replica-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-xs);
    border-radius: var(--radius-sm);
    border-top: 1px solid var(--border);
    font-size: 14px;
  }

  .replica-avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .replica-avatar :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  .replica-avatar--income {
    background: var(--money-light);
    color: var(--income);
  }

  .replica-row-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .replica-row-title {
    color: var(--ink);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .replica-row-sub {
    font-size: 12px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .replica-row-amount {
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-subtitle {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-replica {
      margin-top: var(--space-xl);
    }
  }
</style>
