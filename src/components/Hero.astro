---
import { Icon } from 'astro-icon/components';

const REGISTER_URL = 'https://app.chapa.money/welcome';
const LOGIN_URL = 'https://app.chapa.money/login';
const monthLabel = new Intl.DateTimeFormat('es-PE', { month: 'long' }).format(new Date());
---

<section class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">Captura por correo · Yape &amp; Plin</p>
      <h1>
        Tu dinero,<br />
        todo en <em>un lugar</em>.
      </h1>
      <p class="hero-subtitle">
        Reenvía a Chapa el correo de alerta de Yape, Plin o tu banco y el movimiento se registra
        solo. Nada que anotar, nada que recordar.
      </p>
      <div class="hero-actions">
        <a href={REGISTER_URL} class="btn btn-primary">Crear cuenta gratis</a>
        <a href={LOGIN_URL} class="btn btn-outline">Iniciar sesión</a>
      </div>
      <p class="hero-note">Gratis para empezar</p>
    </div>

    <div class="hero-demo" aria-hidden="true">
      <div class="email-banner">
        <span class="email-icon"><Icon name="lucide:mail" /></span>
        <div class="email-text">
          <strong>Alerta bancaria detectada</strong>
          <span>Yape · Pago recibido +S/ 35.00</span>
        </div>
      </div>

      <div class="app-card">
        <div class="app-card-top">
          <p class="app-card-kicker">Gasto de hoy</p>
          <p class="app-card-amount">S/ 42.30</p>
        </div>
        <div class="app-card-bottom">
          <p class="app-card-label">Balance de {monthLabel}</p>
          <div class="balance-cols">
            <div class="balance-col">
              <span>Ingresos</span>
              <strong class="income">S/ 1,240.00</strong>
            </div>
            <div class="balance-col">
              <span>Egresos</span>
              <strong class="expense">S/ 486.30</strong>
            </div>
            <div class="balance-col">
              <span>Neto</span>
              <strong class="income">S/ 753.70</strong>
            </div>
          </div>

          <p class="app-card-label movements-label">Últimos movimientos</p>
          <div class="ledger-row ledger-row-new">
            <span class="pill" style="background:var(--yape-light);color:var(--yape)">
              <span class="pill-dot"></span>Yape
            </span>
            <span class="ledger-row-text">Juan Pérez</span>
            <span class="ledger-row-amount">+S/ 35.00</span>
          </div>
          <div class="ledger-row">
            <span class="pill" style="background:var(--plin-light);color:var(--plin-dark)">
              <span class="pill-dot"></span>Plin
            </span>
            <span class="ledger-row-text">María Flores</span>
            <span class="ledger-row-amount">+S/ 60.00</span>
          </div>
          <div class="ledger-row">
            <span class="pill" style="background:var(--warning-light);color:var(--warning)">
              <span class="pill-dot"></span>Mercado
            </span>
            <span class="ledger-row-text">Tottus</span>
            <span class="ledger-row-amount expense">-S/ 42.30</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-xxl) calc(var(--space-xxxl) * 1.3);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 18% 20%, var(--primary-light) 0%, transparent 45%),
      radial-gradient(circle at 85% 0%, var(--yape-light) 0%, transparent 35%);
    z-index: -1;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--space-xxxl);
  }

  .eyebrow {
    color: var(--primary-deep);
    margin-bottom: var(--space-lg);
  }

  h1 {
    font-size: clamp(40px, 6vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: var(--space-lg);
  }

  h1 em {
    font-style: italic;
    color: var(--primary);
  }

  .hero-subtitle {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 46ch;
    margin-bottom: var(--space-xl);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .hero-note {
    font-size: 13px;
    color: var(--text-muted);
  }

  /* Demo: correo bancario detectado que cae dentro del registro */
  .hero-demo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 56px;
  }

  .email-banner {
    position: absolute;
    top: 0;
    width: calc(100% - 24px);
    max-width: 320px;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.18);
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    animation: email-cycle 7s var(--ease) infinite;
  }

  .email-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
    background: var(--primary);
    color: var(--white);
    font-family: var(--font-display);
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .email-icon :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
    color: var(--white);
  }

  .email-text {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.4;
  }

  .email-text strong {
    font-size: 13px;
  }

  .email-text span {
    color: var(--text-secondary);
  }

  /* Espejo del hero card del dashboard: dos zonas, único elemento elevado del demo */
  .app-card {
    width: 100%;
    max-width: 340px;
    background: var(--white);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lift);
  }

  .app-card-top {
    background: var(--primary);
    padding: var(--space-lg);
    text-align: center;
  }

  .app-card-kicker {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: var(--space-xs);
  }

  .app-card-amount {
    font-family: var(--font-sans);
    font-size: 34px;
    font-weight: 700;
    color: var(--white);
    font-variant-numeric: tabular-nums;
  }

  .app-card-bottom {
    background: var(--surface-tint);
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-sm);
  }

  .app-card-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .movements-label {
    margin-top: var(--space-sm);
  }

  .balance-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    text-align: center;
  }

  .balance-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .balance-col span {
    font-size: 11px;
    color: var(--text-muted);
  }

  .balance-col strong {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
  }

  .balance-col .income {
    color: var(--income);
  }

  .balance-col .expense {
    color: var(--expense);
  }

  .ledger-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-xs);
    border-radius: var(--radius-sm);
    border-top: 1px solid var(--border);
    font-size: 14px;
  }

  .ledger-row-text {
    flex: 1;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ledger-row-amount {
    font-weight: 700;
    color: var(--income);
  }

  .ledger-row-amount.expense {
    color: var(--expense);
  }

  .ledger-row-new {
    animation: row-cycle 7s var(--ease) infinite;
  }

  @keyframes email-cycle {
    0% {
      opacity: 0;
      transform: translateY(-16px);
    }
    8% {
      opacity: 1;
      transform: translateY(0);
    }
    34% {
      opacity: 1;
      transform: translateY(0);
    }
    42% {
      opacity: 0;
      transform: translateY(-16px);
    }
    100% {
      opacity: 0;
      transform: translateY(-16px);
    }
  }

  @keyframes row-cycle {
    0% {
      opacity: 0;
      background: transparent;
    }
    38% {
      opacity: 0;
      background: transparent;
    }
    46% {
      opacity: 1;
      background: var(--money-light);
    }
    70% {
      opacity: 1;
      background: transparent;
    }
    94% {
      opacity: 1;
      background: transparent;
    }
    100% {
      opacity: 0;
      background: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .email-banner {
      animation: none;
      opacity: 1;
    }
    .ledger-row-new {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-subtitle {
      margin-inline: auto;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-demo {
      margin-top: var(--space-xl);
    }
  }
</style>
