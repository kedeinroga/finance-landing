---
const steps = [
  {
    number: '01',
    title: 'Entra a tu cuenta',
    description:
      'Inicia sesión con tu correo. Tu dashboard se adapta a si eres independiente o tienes un negocio, y puedes instalarla como app desde Ajustes.',
  },
  {
    number: '02',
    title: 'Elige cómo registrar',
    description:
      'Activa el reenvío de alertas o conecta tu Gmail desde Ajustes, e importa tu historial. También puedes anotar a mano cuando quieras.',
  },
  {
    number: '03',
    title: 'Mira tu dashboard',
    description: 'Cada movimiento entra al dashboard. Tú solo revisas el resumen y categorizas si quieres.',
  },
];
---

<section class="how" id="como-funciona">
  <div class="container">
    <div class="section-head center" data-reveal>
      <h2 class="section-title">De entrar a tener todo registrado</h2>
    </div>

    <div class="steps">
      {
        steps.map((step, i) => (
          <div class="step" data-reveal style={`transition-delay:${i * 0.1}s`}>
            <span class="step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .how {
    padding-block: var(--space-xxxl);
    background: var(--surface);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-xxl);
    position: relative;
  }

  .step {
    position: relative;
    padding-top: var(--space-md);
    border-top: 2px solid var(--ink);
  }

  .step-number {
    display: block;
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 600;
    color: var(--primary);
    margin-bottom: var(--space-md);
  }

  .step h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .step p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 32ch;
  }
</style>
