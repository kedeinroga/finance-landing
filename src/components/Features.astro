---
import { Icon } from 'astro-icon/components';

const methods = [
  {
    icon: 'lucide:mail-check',
    title: 'Reenvía tus alertas',
    description:
      'Reenvía a tu dirección de Chapa la alerta de Yape o de tu banco (BCP, Interbank, BBVA o Scotiabank). Extraemos el monto y la persona, sea un pago con Yape, Plin o tarjeta, y queda registrado.',
  },
  {
    icon: 'lucide:mail',
    title: 'Conecta tu Gmail',
    beta: true,
    description:
      'Autoriza tu Gmail y detectamos las alertas de tu banco solas, sin reenviar nada. Solo leemos alertas bancarias, nunca tus correos personales.',
  },
  {
    icon: 'lucide:history',
    title: 'Importa tu historial',
    beta: true,
    description:
      'Con Gmail conectado, elige un mes y revisa lo que encontramos antes de guardarlo. Marcamos los posibles duplicados para que no empieces de cero.',
  },
  {
    icon: 'lucide:pencil-line',
    title: 'Anótalo a mano',
    description:
      '¿Pagaste en efectivo? Agrega cualquier ingreso o gasto en segundos, con su categoría, y queda junto al resto.',
  },
];
---

<section class="features" id="captura">
  <div class="container">
    <div class="section-head center" data-reveal>
      <h2 class="section-title">Cuatro formas de registrar tus movimientos</h2>
      <p class="section-subtitle">
        Usa la que te acomode, o combínalas: todas terminan en el mismo dashboard.
      </p>
    </div>

    <div class="methods-grid">
      {
        methods.map((method, i) => (
          <div class="method-card" data-reveal style={`transition-delay:${i * 0.08}s`}>
            <div class="method-badge">
              <Icon name={method.icon} />
            </div>
            <div class="method-title-row">
              <h3>{method.title}</h3>
              {method.beta && <span class="tag-beta">Beta</span>}
            </div>
            <p>{method.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--space-xxxl);
  }

  /* 5 columnas para una rejilla asimétrica: 3+2 arriba, 2+3 abajo */
  .methods-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--space-lg);
  }

  .method-card {
    grid-column: span 2;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-xl) var(--space-lg);
  }

  .method-card:nth-child(1),
  .method-card:nth-child(4) {
    grid-column: span 3;
  }

  @media (max-width: 760px) {
    .methods-grid {
      grid-template-columns: 1fr;
    }

    .method-card,
    .method-card:nth-child(1),
    .method-card:nth-child(4) {
      grid-column: span 1;
    }
  }

  .method-badge {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-light);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
    color: var(--primary-deep);
  }

  .method-badge :global(svg) {
    width: 22px;
    height: 22px;
    stroke-width: 1.75;
  }

  .method-title-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .method-card h3 {
    font-size: 18px;
    font-weight: 600;
  }

  .method-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>
