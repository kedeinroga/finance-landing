---
import { Icon } from 'astro-icon/components';

const features = [
  {
    icon: 'lucide:mail-check',
    title: 'Captura automática',
    description:
      'Reenvía el correo de Yape, Plin o tu banco y el pago se registra solo. Cero anotaciones manuales.',
  },
  {
    icon: 'lucide:bar-chart-3',
    title: 'Dashboard a tu medida',
    description:
      'Visibilidad de gasto por categoría si eres independiente, o caja del día por fuente si tienes un negocio.',
  },
  {
    icon: 'lucide:receipt',
    title: 'Cierre de caja',
    description:
      'Emprendedores: cierra tu caja al final del día y arranca el siguiente lote con un total claro de ingresos, gastos y neto.',
  },
  {
    icon: 'lucide:globe',
    title: 'Multi-moneda',
    description:
      'Soles y dólares se llevan por separado, sin mezclarse en un solo total. Cada moneda con su propio resumen.',
  },
  {
    icon: 'lucide:zap',
    title: 'Conexión Gmail',
    soon: true,
    description:
      'Autoriza tu Gmail y las alertas de tu banco se detectan en tiempo real, sin reenviar nada. Disponible en beta cerrada mientras completamos la verificación de Google.',
  },
];
---

<section class="features" id="captura">
  <div class="container">
    <div class="section-head center" data-reveal>
      <h2 class="section-title">Lo que pasa apenas reenvías el correo</h2>
      <p class="section-subtitle">
        Reenvía el correo de alerta de Yape, Plin o tu banco a tu dirección de Chapa; extraemos el
        monto y la persona, y lo sumamos a tu registro sin que toques nada.
      </p>
    </div>

    <div class="features-grid">
      {
        features.map((feature, i) => (
          <div class="feature-card" data-reveal style={`transition-delay:${i * 0.08}s`}>
            <div class="feature-badge">
              <Icon name={feature.icon} />
            </div>
            <h3>{feature.title}</h3>
            {feature.soon && <span class="feature-badge-soon">Próximamente</span>}
            <p>{feature.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--space-xxxl);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: var(--space-lg);
  }

  .feature-card {
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: var(--space-xl) var(--space-lg);
  }

  .feature-card:first-child {
    grid-column: span 2;
  }

  @media (max-width: 600px) {
    .feature-card:first-child {
      grid-column: span 1;
    }
  }

  .feature-badge {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--primary-light);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
    color: var(--primary-deep);
  }

  .feature-badge :global(svg) {
    width: 22px;
    height: 22px;
    stroke-width: 1.75;
  }

  .feature-badge-soon {
    display: inline-block;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .feature-card h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: var(--space-sm);
  }

  .feature-card p {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
  }
</style>
