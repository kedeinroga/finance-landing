---
interface Section {
  title: string;
  body: string;
  items?: string[];
}

interface Props {
  title: string;
  lastUpdated: string;
  sections: Section[];
}

const { title, lastUpdated, sections } = Astro.props;
---

<article class="legal">
  <div class="container legal-inner">
    <header class="legal-head">
      <h1>{title}</h1>
      <p class="legal-meta">Última actualización: {lastUpdated}</p>
    </header>

    <div class="legal-sections">
      {
        sections.map((section) => (
          <section class="legal-section">
            <h2>{section.title}</h2>
            <p>{section.body}</p>
            {section.items && (
              <ul class="legal-list">
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            )}
          </section>
        ))
      }
    </div>
  </div>
</article>

<style>
  .legal {
    padding-block: var(--space-xxl) var(--space-xxxl);
  }

  .legal-inner {
    max-width: 720px;
  }

  .legal-head {
    margin-bottom: var(--space-xxl);
  }

  h1 {
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-sm);
  }

  .legal-meta {
    font-size: 13px;
    color: var(--text-muted);
  }

  .legal-sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .legal-section h2 {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--primary-deep);
    margin-bottom: var(--space-sm);
  }

  .legal-section p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .legal-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    padding-left: var(--space-lg);
  }

  .legal-list li {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-secondary);
    list-style: disc;
  }
</style>
