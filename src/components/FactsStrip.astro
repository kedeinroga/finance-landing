---
const facts = [
  { num: 'Yape, Plin y 4 bancos', sub: 'BCP, Interbank, BBVA y Scotiabank' },
  { num: 'Soles y dólares', sub: 'Siempre por separado, nunca sumados' },
  { num: '2 dashboards', sub: 'Uno para tu sueldo, otro para tu negocio' },
];
---

<section class="facts" id="hechos">
  <div class="container facts-grid">
    {
      facts.map((fact) => (
        <div class="facts-item">
          <span class="facts-num">{fact.num}</span>
          <span class="facts-sub">{fact.sub}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .facts {
    padding-block: var(--space-xl);
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .facts-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .facts-num {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
  }

  .facts-sub {
    font-size: 13px;
    color: var(--text-secondary);
  }

  @media (max-width: 760px) {
    .facts-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .facts-item {
      padding-block: var(--space-md);
      border-top: 1px solid var(--border);
    }

    .facts-item:first-child {
      border-top: none;
    }
  }
</style>
