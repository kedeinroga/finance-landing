---
import { Icon } from 'astro-icon/components';

const minus = '−';
---

<section class="showcase" id="analiza-tu-plata">
  <div class="container showcase-inner">
    <div class="showcase-copy" data-reveal>
      <p class="eyebrow">análisis y caja</p>
      <h2>Analiza tu plata</h2>
      <p>
        Resumen semanal, comparación con el mes anterior, y para tu negocio, cierre de caja por
        lotes sin hacer cuentas a mano.
      </p>
    </div>

    <div class="showcase-replicas" aria-hidden="true" data-reveal>
      <div class="showcase-card showcase-card--back">
        <div class="showcase-top">
          <span class="showcase-top-title">Análisis</span>
          <span class="showcase-top-meta">· septiembre</span>
        </div>
        <div class="showcase-body">
          <div class="showcase-ring-wrap">
            <div class="ring-shape">
              <svg viewBox="0 0 140 140" width="140" height="140">
                <circle cx="70" cy="70" r="58" fill="none" stroke="var(--border)" stroke-width="12" />
                <circle
                  cx="70"
                  cy="70"
                  r="58"
                  fill="none"
                  stroke="var(--primary)"
                  stroke-width="12"
                  stroke-linecap="round"
                  stroke-dasharray="182.2 364.4"
                  stroke-dashoffset="0"
                  transform="rotate(-90 70 70)"
                />
                <circle
                  cx="70"
                  cy="70"
                  r="58"
                  fill="none"
                  stroke="var(--money)"
                  stroke-width="12"
                  stroke-linecap="round"
                  stroke-dasharray="91.1 364.4"
                  stroke-dashoffset="-182.2"
                  transform="rotate(-90 70 70)"
                />
                <circle
                  cx="70"
                  cy="70"
                  r="58"
                  fill="none"
                  stroke="var(--plin)"
                  stroke-width="12"
                  stroke-linecap="round"
                  stroke-dasharray="54.7 364.4"
                  stroke-dashoffset="-273.3"
                  transform="rotate(-90 70 70)"
                />
                <circle
                  cx="70"
                  cy="70"
                  r="58"
                  fill="none"
                  stroke="var(--warning-light)"
                  stroke-width="12"
                  stroke-linecap="round"
                  stroke-dasharray="36.4 364.4"
                  stroke-dashoffset="-328"
                  transform="rotate(-90 70 70)"
                />
              </svg>
              <div class="ring-center">
                <span class="ring-center-count">4</span>
                <span class="ring-center-caption">categorías</span>
              </div>
            </div>
            <p class="ring-legend"><strong>50%</strong> en Alimentación</p>
          </div>
        </div>
      </div>

      <div class="showcase-card showcase-card--front">
        <div class="showcase-top">
          <span class="showcase-top-title">Balance de la caja</span>
        </div>
        <div class="showcase-body">
          <p class="replica-net tone-income">+S/ 234<span class="cents">.00</span></p>
          <div class="showcase-rows">
            <div class="showcase-row">
              <span class="showcase-avatar showcase-avatar--income">
                <Icon name="lucide:arrow-down-left" />
              </span>
              <span class="showcase-row-title">Cobrado</span>
              <span class="showcase-row-value tone-income">+S/ 282.50</span>
            </div>
            <div class="showcase-row">
              <span class="showcase-avatar showcase-avatar--neutral">
                <Icon name="lucide:arrow-up-right" />
              </span>
              <span class="showcase-row-title">Gastado</span>
              <span class="showcase-row-value tone-ink">{minus}S/ 48.50</span>
            </div>
          </div>
          <button class="btn btn-outline" type="button" tabindex="-1">Cerrar caja</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .showcase {
    padding-block: var(--space-xxxl);
    background: var(--surface);
  }

  .showcase-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-xxxl);
  }

  .showcase-copy .eyebrow {
    color: var(--primary-deep);
    margin-bottom: var(--space-lg);
  }

  .showcase-copy h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: var(--space-md);
  }

  .showcase-copy p {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 42ch;
  }

  .showcase-replicas {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    width: 100%;
    max-width: 380px;
    margin-inline: auto;
  }

  .showcase-card {
    width: 100%;
    max-width: 300px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .showcase-card--back {
    box-shadow: var(--shadow-card);
    align-self: flex-start;
  }

  .showcase-card--front {
    box-shadow: var(--shadow-lift);
    position: relative;
    z-index: 1;
    margin-top: -72px;
  }

  .showcase-top {
    padding: var(--space-md) var(--space-lg);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    color: var(--white);
  }

  .showcase-card--back .showcase-top {
    background: var(--primary);
  }

  .showcase-card--front .showcase-top {
    background: var(--money);
  }

  .showcase-top-title {
    font-size: 13px;
    font-weight: 700;
  }

  .showcase-top-meta {
    font-size: 12px;
  }

  .showcase-body {
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-sm);
  }

  .replica-net {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .replica-net .cents {
    font-size: calc(1em * 0.55);
  }

  .tone-income {
    color: var(--income);
  }

  .tone-ink {
    color: var(--ink);
  }

  .showcase-ring-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
  }

  .ring-shape {
    position: relative;
    display: inline-flex;
  }

  .ring-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .ring-center-count {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    color: var(--ink);
  }

  .ring-center-caption {
    font-size: 12px;
    color: var(--text-secondary);
  }

  .ring-legend {
    font-size: 13px;
    color: var(--text-secondary);
    text-align: center;
  }

  .ring-legend strong {
    color: var(--ink);
  }

  .showcase-rows {
    display: grid;
    gap: var(--space-sm);
  }

  .showcase-row {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .showcase-avatar {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .showcase-avatar :global(svg) {
    width: 18px;
    height: 18px;
    stroke-width: 2;
  }

  .showcase-avatar--income {
    background: var(--money-light);
    color: var(--income);
  }

  .showcase-avatar--neutral {
    background: var(--icon-bg);
    color: var(--ink);
  }

  .showcase-row-title {
    flex: 1;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  .showcase-row-value {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
  }

  .showcase-card--front .btn {
    width: 100%;
    margin-top: var(--space-sm);
  }

  @media (max-width: 860px) {
    .showcase-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .showcase-copy p {
      margin-inline: auto;
    }

    .showcase-replicas {
      align-items: center;
      margin-top: var(--space-xl);
    }

    .showcase-card--back {
      align-self: center;
    }

    .showcase-card--front {
      margin-top: var(--space-lg);
    }
  }
</style>
