---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FactsStrip from '../components/FactsStrip.astro';
import Features from '../components/Features.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import Capabilities from '../components/Capabilities.astro';
import PersonaBands from '../components/PersonaBands.astro';
import Privacy from '../components/Privacy.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
