---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import LegalPage from '../components/LegalPage.astro';
import Footer from '../components/Footer.astro';

const sections = [
  {
    title: '1. Aceptación',
    body: 'Al crear una cuenta en Chapa aceptas estos términos. Si no estás de acuerdo, no uses la aplicación.',
  },
  {
    title: '2. Uso del servicio',
    body: 'Chapa te permite registrar cobros, gastos y organizar tu información financiera personal o de tu negocio. Debes usar la app de forma lícita y con datos veraces.',
  },
  {
    title: '3. Cuenta y seguridad',
    body: 'Eres responsable de mantener la confidencialidad de tu contraseña y del acceso a tu dispositivo. Notifícanos ante cualquier uso no autorizado de tu cuenta.',
  },
  {
    title: '4. Datos y privacidad',
    body: 'Tratamos tus datos conforme a nuestra Política de Privacidad. No vendemos tu información personal. Puedes solicitar la eliminación de tu cuenta desde la app.',
  },
  {
    title: '5. Registro por correo del banco (opcional)',
    body: 'Si activas esta función, te damos una dirección de reenvío y tú decides qué correos de alerta de tu banco reenvías. Solo leemos esos correos para extraer la transacción; verificamos que sean de tu banco y descartamos el contenido tras procesarlo. Puedes desconectarla cuando quieras. Ver la Política de Privacidad para el detalle.',
  },
  {
    title: '6. Plan gratuito y Plan Pro',
    body: 'El plan gratuito incluye límites de uso (por ejemplo, cantidad de movimientos por mes). El Plan Pro amplía funciones y límites según se describan en la app.',
  },
  {
    title: '7. Limitación de responsabilidad',
    body: 'Chapa es una herramienta de registro y no sustituye asesoría contable, tributaria ni legal. No garantizamos disponibilidad ininterrumpida del servicio.',
  },
  {
    title: '8. Cambios',
    body: 'Podemos actualizar estos términos. Te avisaremos por correo o dentro de la app cuando los cambios sean relevantes. El uso continuado implica aceptación.',
  },
  {
    title: '9. Contacto',
    body: 'Todavía no publicamos un canal oficial de contacto legal. Mientras tanto, puedes escribirnos desde la propia app.',
  },
];
---

<BaseLayout
  title="Términos de uso — Chapa"
  description="Términos de uso de Chapa. Documento informativo, pendiente de revisión legal."
  noindex
>
  <Header />
  <main>
    <LegalPage title="Términos de uso" lastUpdated="junio 2026" sections={sections} />
  </main>
  <Footer />
</BaseLayout>
